{:description "Batteries-included Clojure/ClojureScript template with AI-friendly tooling (evo-based)"
 :year "{{now/year}}"
 :version "{{version}}"

 ;; Template variables:
 ;; {{top/ns}}    - Top-level namespace (e.g., "com.example")
 ;; {{main/ns}}   - Full namespace (e.g., "com.example.my-app")
 ;; {{name}}      - Project name (e.g., "my-app")
 ;; {{top/file}}  - Top-level directory (e.g., "com/example")
 ;; {{main/file}} - Full directory path (e.g., "com/example/my_app")
 ;; {{raw-name}}  - Raw project name without namespace
 ;; {{now/year}}  - Current year

 :transform
 [;; Root config files (retain as-is with variable substitution)
  {:path "deps.edn" :retain true}
  {:path "shadow-cljs.edn" :retain true}
  {:path "bb.edn" :retain true}
  {:path "package.json" :retain true}
  {:path ".gitignore" :retain true}
  {:path ".mcp.json" :retain true}
  {:path "README.md" :retain true}
  {:path "CLAUDE.md" :retain true}
  {:path "input.css" :retain true}

  ;; Symlink AGENTS.md to CLAUDE.md (done post-creation)

  ;; Clj-kondo config (entire directory with imports)
  {:path ".clj-kondo" :retain true}

  ;; Scripts (universal)
  {:path "scripts/post-create.sh" :retain true}
  {:path "scripts/install-hooks.sh" :retain true}
  {:path "scripts/check-version-sync.sh" :retain true}
  {:path "scripts/load-env.sh" :retain true}
  {:path "scripts/hooks/pre-push" :retain true}

  ;; Dev tools
  {:path "dev/repl.cljc" :retain true}

  ;; Source files (with namespace substitution)
  {:path "src/{{top/file}}/{{main/file}}/main.cljs" :retain true}
  {:path "src/{{top/file}}/{{main/file}}/db.cljc" :retain true}

  ;; Test files
  {:path "test/{{top/file}}/{{main/file}}/db_test.cljc" :retain true}
  {:path "test/fixtures.cljc" :retain true}

  ;; Browser tests
  {:path "test-browser/integration.spec.js" :retain true}
  {:path "test-browser/README.md" :retain true}
  {:path "playwright.config.js" :retain true}

  ;; Public assets
  {:path "public/index.html" :retain true}

  ;; Skills structure (examples)
  {:path "skills/README.md" :retain true}
  {:path "skills/.gitkeep" :retain true}

  ;; GitHub Actions CI (optional)
  {:path ".github/workflows/ci.yml" :retain true}
  {:path ".github/workflows/README.md" :retain true}]}
}
